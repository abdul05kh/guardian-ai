rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function canAccessOrg(resourceOrgId) {
      return resourceOrgId != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == resourceOrgId;
    }

    function isOwner(resourceData) {
      return request.auth.uid == resourceData.userId;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /organizations/{orgId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /digital_assets/{assetId} {
      allow read: if isSignedIn() && (isOwner(resource.data) || canAccessOrg(resource.data.orgId));
      allow create: if isSignedIn() && (isOwner(request.resource.data) || canAccessOrg(request.resource.data.orgId));
      allow update, delete: if isSignedIn() && isOwner(resource.data);
    }

    match /infringement_detections/{detectionId} {
      allow read: if isSignedIn() && (isOwner(resource.data) || canAccessOrg(resource.data.orgId));
      allow create: if isSignedIn() && (isOwner(request.resource.data) || canAccessOrg(request.resource.data.orgId));
      allow update, delete: if isSignedIn() && isOwner(resource.data);
    }

    match /enforcement_policies/{policyId} {
      allow read: if isSignedIn() && (isOwner(resource.data) || canAccessOrg(resource.data.orgId));
      allow create: if isSignedIn() && (isOwner(request.resource.data) || canAccessOrg(request.resource.data.orgId));
      allow update, delete: if isSignedIn() && isOwner(resource.data);
    }

    match /venues/{venueId} {
      allow read: if isSignedIn() && (isOwner(resource.data) || canAccessOrg(resource.data.orgId));
      allow create: if isSignedIn() && (isOwner(request.resource.data) || canAccessOrg(request.resource.data.orgId));
      allow update, delete: if isSignedIn() && isOwner(resource.data);
    }

    match /crisis_events/{eventId} {
      allow read: if isSignedIn() && (isOwner(resource.data) || canAccessOrg(resource.data.orgId));
      allow create: if isSignedIn() && (isOwner(request.resource.data) || canAccessOrg(request.resource.data.orgId));
      allow update, delete: if isSignedIn() && isOwner(resource.data);
    }

    match /audit_log/{logId} {
      allow read: if isSignedIn() && (isOwner(resource.data) || canAccessOrg(resource.data.orgId));
      allow create: if isSignedIn() && isOwner(request.resource.data);
      allow update, delete: if false;
    }

    match /dmca_notices/{noticeId} {
      allow read: if isSignedIn() && (isOwner(resource.data) || canAccessOrg(resource.data.orgId));
      allow create: if isSignedIn() && (isOwner(request.resource.data) || canAccessOrg(request.resource.data.orgId));
      allow update, delete: if isSignedIn() && isOwner(resource.data);
    }
  }
}
