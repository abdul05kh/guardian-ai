rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection - users can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null; // Allow reading other user profiles (for responder board)
    }
    
    // Organizations - members can read, admins can write
    match /organizations/{orgId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Digital Assets - authenticated users can CRUD
    match /digital_assets/{assetId} {
      allow read, write: if request.auth != null;
    }
    
    // Infringement Detections - authenticated users can read/write
    match /infringement_detections/{detectionId} {
      allow read, write: if request.auth != null;
    }
    
    // DMCA Notices - authenticated users can read/write
    match /dmca_notices/{noticeId} {
      allow read, write: if request.auth != null;
    }
    
    // Venues - authenticated users can read/write
    match /venues/{venueId} {
      allow read, write: if request.auth != null;
    }
    
    // Crisis Events - authenticated users can read/write
    match /crisis_events/{eventId} {
      allow read, write: if request.auth != null;
      
      match /crisis_actions/{actionId} {
        allow read, write: if request.auth != null;
      }
    }
    
    // Audit Log - authenticated users can read, system can write
    match /audit_log/{logId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
